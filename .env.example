# This is an example file for the root docker-compose setup
# Copy this to .env and fill in your values

# Backend Environment Variables
# Copy these values from backend/.env
NODE_ENV=production
PORT=10000
BASE_PATH=/api

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/flowmatic?retryWrites=true&w=majority

SESSION_SECRET=your-session-secret-min-32-characters
JWT_SECRET=your-jwt-secret-min-32-characters

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-url.com/api/auth/google/callback

FRONTEND_ORIGIN=https://your-netlify-app.netlify.app
FRONTEND_GOOGLE_CALLBACK_URL=https://your-netlify-app.netlify.app/auth/google/callback
